# --- Puertos y entorno
PORT=3000
NODE_ENV=development

# --- Supabase (Project Settings -> API Keys)
#
# Nombres actuales: `sb_publishable_...` y `sb_secret_...`. Supabase
# deprecia `anon` y `service_role` a fines de 2026.
#
# Clave publicable: no es un secreto (es la misma que usa el navegador).
# La usa TODO lo que corre con la identidad de un usuario: el backend
# arma el cliente con esta clave + el JWT del usuario, y RLS decide fila
# por fila. No hay ninguna operacion de datos que necesite mas.
#
# Tambien se aceptan los nombres VITE_* (abajo, comentados), porque el
# .env se comparte con el frontend de Vite.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave secreta: saltea RLS. La usa UNICAMENTE el flujo de webhooks de
# canales, que no tiene usuario al que atribuir la operacion. Nunca con
# prefijo VITE_ (terminaria en el bundle del navegador), nunca en el
# repositorio.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Canales
# Identificador del panel que puede pedir canales de tipo WEB.
WEB_CHANNEL_IDENTIFIER=web
# Secreto opcional del webhook de Telegram (header X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=
# Token de verificacion de Meta (WhatsApp).
VERIFY_TOKEN=
